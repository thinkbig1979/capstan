# Docker Manager Configuration
# Copy this file to .env and customize for your environment

# === Required ===

# JWT Secret (min 32 characters, required unless AUTH_DISABLED=true)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# === Recommended ===

# Storage key: derives the at-rest encryption key for stored secrets (git
# tokens, restic password) independently of JWT_SECRET. Strongly recommended so
# rotating JWT_SECRET does not require re-encryption and so disclosing
# JWT_SECRET alone cannot decrypt stored secrets. If unset, JWT_SECRET is used.
# Generate with: openssl rand -hex 32
STORAGE_KEY=

# Root directory containing Docker Compose stacks
STACKS_DIR=/opt/stacks

# Host path must match STACKS_DIR for Docker Compose operations to work
HOST_STACKS_DIR=/opt/stacks

# === Optional ===

# Server port (default: 5001)
PORT=5001

# Data directory for SQLite database (default: /app/data)
DATA_DIR=/app/data

# Log level: debug, info, warn, error (default: info)
# Log format: text or json (default: text)
# An unrecognised value stops the server at startup rather than silently
# falling back, so a typo is visible immediately. Use json when shipping to an
# aggregator (Loki, Elasticsearch); text is easier to read at a terminal.
# Every log line carries a request_id, also returned in the X-Request-ID
# response header and recorded on the matching action_log row.
LOG_LEVEL=info
LOG_FORMAT=text

# Disable authentication - only safe on trusted networks!
# When enabled, access is restricted to TRUSTED_NETWORKS
AUTH_DISABLED=false

# Comma-separated CIDR ranges allowed when AUTH_DISABLED=true
# TRUSTED_NETWORKS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1,::1

# Comma-separated CIDR ranges, beyond loopback, allowed to reach /health
# (liveness) and /health/ready (readiness). Empty means loopback only, which is
# all the container's own HEALTHCHECK needs. Set this to let an external uptime
# monitor or load balancer probe Capstan.
#
# Deliberately separate from TRUSTED_NETWORKS: that value is also the
# trusted-proxy list and the AUTH_DISABLED bypass list, so reusing it would
# grant a monitor X-Forwarded-For spoofing and auth bypass just to read health.
# HEALTH_ALLOWED_NETWORKS=10.1.0.0/16

# CORS origins (comma-separated, empty = same-origin only)
# CORS_ORIGINS=https://your-domain.com

# Git SSH key path for private repos (default: ~/.ssh/id_rsa)
# GIT_SSH_KEY=/path/to/id_rsa

# Git HTTPS credentials for private repos
# GIT_HTTPS_USER=git
# GIT_HTTPS_TOKEN=

# === Backups (restic + rclone) ===
# These are env-var fallbacks. Settings configured in the UI (Settings → Backup)
# take precedence at runtime, so you can also leave these unset and configure
# everything through the web interface — the password is stored encrypted at rest.

# Path to the restic repository inside the container.
# Default: {DATA_DIR}/restic-repo (i.e. /app/data/restic-repo when DATA_DIR=/app/data)
# The ./data directory MUST be a host bind mount so snapshots survive container recreation.
# RESTIC_REPOSITORY=/app/data/restic-repo

# Restic repository password. Use a strong passphrase — this encrypts your backups.
# Store securely; losing it means losing access to all snapshots.
# RESTIC_PASSWORD=

# Retention policy (number of snapshots to keep; defaults: 7/4/6/0)
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# BACKUP_KEEP_YEARLY=0

# Run restic prune automatically after forget (default: true)
# BACKUP_AUTO_PRUNE=true

# Backup schedule interval in minutes (0 = disabled; configure in UI instead)
# BACKUP_SCHEDULE_INTERVAL=0

# Run an rclone sync automatically after each local backup (default: false)
# BACKUP_SYNC_AFTER=false

# rclone remote name as configured in rclone.conf (e.g. s3, b2, gdrive)
# RCLONE_REMOTE=

# Remote path/bucket for the sync destination (e.g. my-bucket/capstan-backups)
# RCLONE_PATH=capstan-backups

# Number of parallel rclone transfers (default: 4)
# RCLONE_TRANSFERS=4

# Hostname tag stored in restic snapshots (default: system hostname)
# BACKUP_HOSTNAME=
