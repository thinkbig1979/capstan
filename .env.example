# Docker Manager Configuration
# Copy this file to .env and customize for your environment

# === Required ===

# JWT Secret (min 32 characters, required unless AUTH_DISABLED=true)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Root directory containing Docker Compose stacks
STACKS_DIR=/opt/stacks

# Host path must match STACKS_DIR for Docker Compose operations to work
HOST_STACKS_DIR=/opt/stacks

# === Optional ===

# Server port (default: 5001)
PORT=5001

# Data directory for SQLite database (default: /app/data)
DATA_DIR=/app/data

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Disable authentication - only safe on trusted networks!
# When enabled, access is restricted to TRUSTED_NETWORKS
AUTH_DISABLED=false

# Comma-separated CIDR ranges allowed when AUTH_DISABLED=true
# TRUSTED_NETWORKS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1,::1

# CORS origins (comma-separated, empty = same-origin only)
# CORS_ORIGINS=https://your-domain.com

# Git SSH key path for private repos (default: ~/.ssh/id_rsa)
# GIT_SSH_KEY=/path/to/id_rsa

# Git HTTPS credentials for private repos
# GIT_HTTPS_USER=git
# GIT_HTTPS_TOKEN=
