.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build
dist/
build/
*.log

# Compiled Go binaries and test binaries
/server
backend/server
backend/server-new
backend/bin/
*.test

# Dependencies
node_modules
vendor/

# Dolt database files (added by bd init)
.dolt/
*.db

# Local environment overrides
backend/.env
frontend/.env
backend/server

# SSH keys (keep the README)
keys/*
!keys/README.md

# Runtime bind-mount data (compose mounts ./data and ./stacks into the container)
/data/
/stacks/

# Backend embedded frontend (built during Docker build)
backend/frontend/assets/
:memory:

# Transient test/report artifacts (already excluded by .dockerignore).
# Real, curated screenshots belong under Supporting-Docs/, not the repo root.
/screenshots/
/scorecard.png
/reports/

# Playwright's own output (agent-os-5y9). Everything under testing/reports/ is
# generated: /test-results/ is Playwright's default trace/attachment outputDir
# (created on any local failing run), the html/json paths are the reporter
# outputs configured in playwright.config.ts, and screenshots/ is that config's
# screenshotsPath. Nothing in testing/reports/ is tracked any more — the two
# committed bash-harness fixtures that used to live there went with the bash
# test framework (agent-os-uc4u).
/test-results/
/testing/reports/playwright-html/
/testing/reports/playwright-results.json
/testing/reports/screenshots/

# Beads / Dolt files (added by bd init)
.beads-credential-key

# ── Private dev tooling & internal docs (kept local, not tracked in this public repo) ──
# These remain on disk and keep working locally; they're just not published.
.agent-os/
.claude/
.drift/
.opencode/
.beads/
Supporting-Docs/
AGENTS.md
PLAN.md
Dockge_Replacement_App_Plan
# Missed by the original sweep (commit 5098a66) and untracked later: agent/editor
# tooling that is local-only in practice. .mcp.json in particular pointed at
# .claude/cclsp.json, which this file already ignores — so every fresh clone got
# an MCP server config referencing a file that was never published. .driftignore
# configured a .drift/ directory that is ignored above and does not exist here.
.agents/
.mcp.json
skills-lock.json
.driftignore

# Stray restic repository skeletons (a relative-path restic init bug once
# created one in a package dir during tests; agent-os-4pa.1)
restic-repo/
