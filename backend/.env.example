# JWT Secret (min 32 characters, required unless AUTH_DISABLED=true)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Storage key for encrypting stored secrets (git tokens, restic password) at
# rest, derived independently of JWT_SECRET. Recommended. If unset, JWT_SECRET
# is used. Generate with: openssl rand -hex 32
STORAGE_KEY=

# Server Configuration
PORT=5001
LOG_LEVEL=info

# Stacks Directory (where Docker Compose files are stored)
STACKS_DIR=/opt/stacks

# Data Directory (database, logs, etc.)
DATA_DIR=/app/data

# Git Configuration
# Path to an SSH private key FILE for git operations (a filesystem path, not the
# key contents). Optional.
GIT_SSH_KEY=/root/.ssh/id_rsa

# HTTPS token for private git repos (optional)
GIT_HTTPS_TOKEN=

# HTTPS username for git (default: git)
GIT_HTTPS_USER=git

# Disable authentication. Only safe on a trusted/loopback-only network — it
# bypasses login entirely. Leave false for any networked deployment.
AUTH_DISABLED=false

# CORS Origins (comma-separated, empty = all origins allowed)
CORS_ORIGINS=

# === Backups (restic + rclone) ===
# Optional env-var fallbacks. Settings configured in the UI (Settings → Backup)
# take precedence at runtime, so you can also configure everything through the
# web interface — the password is stored encrypted at rest.

# RESTIC_REPOSITORY=/app/data/restic-repo
# RESTIC_PASSWORD=
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# BACKUP_KEEP_YEARLY=0
# BACKUP_AUTO_PRUNE=true
# BACKUP_SCHEDULE_INTERVAL=0
# BACKUP_SYNC_AFTER=false
# RCLONE_REMOTE=
# RCLONE_PATH=capstan-backups
# RCLONE_TRANSFERS=4
# BACKUP_HOSTNAME=
